{
    "name": "agentes/agent-core",
    "description": "Ciclo de agente con tool calling, independiente del framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": { "Agentes\\Core\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Agentes\\Core\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.4.0" },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    }
}
