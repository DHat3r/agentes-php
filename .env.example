# Copia este archivo a .env y completa la key. Nunca subas .env al repo.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Modelo que hace de juez en el evaluador QA (puede ser el mismo)
OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini

# Postgres compartido (una base por app, se crean en docker/postgres/init.sql)
DB_USERNAME=agentes
DB_PASSWORD=cambia-esta-clave

# Puerto del gateway nginx en tu máquina
GATEWAY_PORT=8080
