# Copia este archivo a .env y completa la key. Nunca subas .env al repo.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Modelos gratuitos (sufijo :free). Puedes poner varios separados por coma: si el primero
# falla o llega a su límite de uso, OpenRouter prueba el siguiente (fallback).
# Todos deben soportar tool calling: https://openrouter.ai/models?supported_parameters=tools
# openrouter/free va al final: elige al azar entre modelos gratis, útil como último respaldo.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
# Modelo que hace de juez en el evaluador QA: basta uno rápido.
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,openrouter/free

# Postgres compartido (una base por app, se crean en docker/postgres/init.sql)
DB_USERNAME=agentes
DB_PASSWORD=cambia-esta-clave

# Puerto del gateway nginx en tu máquina
GATEWAY_PORT=8080
